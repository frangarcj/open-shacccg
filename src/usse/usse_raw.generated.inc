        !fits(static_cast<uint64_t>(fields.src2_vector_scalar_component), 1) || !fits(static_cast<uint64_t>(fields.repeat_count), 2) || !fits(static_cast<uint64_t>(fields.sign_test), 2) ||
        !fits(static_cast<uint64_t>(fields.zero_test), 2) || !fits(static_cast<uint64_t>(fields.test_crcomb_and), 1) || !fits(static_cast<uint64_t>(fields.channel), 3) ||
        !fits(static_cast<uint64_t>(fields.predicate_destination), 2) || !fits(static_cast<uint64_t>(fields.dest_bank), 2) || !fits(static_cast<uint64_t>(fields.src1_bank), 2) ||
        !fits(static_cast<uint64_t>(fields.src2_bank), 2) || !fits(static_cast<uint64_t>(fields.dest_num), 7) || !fits(static_cast<uint64_t>(fields.test_write_enable), 1) ||
        !fits(static_cast<uint64_t>(fields.alu_select), 2) || !fits(static_cast<uint64_t>(fields.alu_op), 4) || !fits(static_cast<uint64_t>(fields.src1_num), 7) ||
        !fits(static_cast<uint64_t>(fields.src2_num), 7)) return false;
    *word = kVtstExpected
        | bits(fields.pred, 56, 3)
        | bits(fields.skip_invalid, 55, 1)
        | bits(fields.once_only, 53, 1)
        | bits(fields.sync_start, 52, 1)
        | bits(fields.dest_ext, 51, 1)
        | bits(fields.src1_negative, 50, 1)
        | bits(fields.src1_ext, 49, 1)
        | bits(fields.src2_ext, 48, 1)
        | bits(fields.precision, 47, 1)
        | bits(fields.src2_vector_scalar_component, 46, 1)
        | bits(fields.repeat_count, 44, 2)
        | bits(fields.sign_test, 42, 2)
        | bits(fields.zero_test, 40, 2)
        | bits(fields.test_crcomb_and, 39, 1)
        | bits(fields.channel, 36, 3)
        | bits(fields.predicate_destination, 34, 2)
        | bits(fields.dest_bank, 32, 2)
        | bits(fields.src1_bank, 30, 2)
        | bits(fields.src2_bank, 28, 2)
        | bits(fields.dest_num, 21, 7)
        | bits(fields.test_write_enable, 20, 1)
        | bits(fields.alu_select, 18, 2)
        | bits(fields.alu_op, 14, 4)
        | bits(fields.src1_num, 7, 7)
        | bits(fields.src2_num, 0, 7);
    return true;
}

bool decode_vbw(uint64_t word, VbwFields *fields) {
    if (!fields || (word & kVbwMask) != kVbwExpected) return false;
    fields->op1 = field<uint8_t>(word, 59, 3);
    fields->pred = field<uint8_t>(word, 56, 3);
    fields->skip_invalid = field<uint8_t>(word, 55, 1);
    fields->no_schedule = field<uint8_t>(word, 54, 1);
    fields->repeat_select = field<uint8_t>(word, 53, 1);
    fields->sync_start = field<uint8_t>(word, 52, 1);
    fields->dest_ext = field<uint8_t>(word, 51, 1);
    fields->end = field<uint8_t>(word, 50, 1);
    fields->src1_ext = field<uint8_t>(word, 49, 1);
    fields->src2_ext = field<uint8_t>(word, 48, 1);
    fields->repeat_count = field<uint8_t>(word, 44, 4);
    fields->src2_invert = field<uint8_t>(word, 43, 1);
    fields->src2_rotate = field<uint8_t>(word, 38, 5);
    fields->src2_extra_high = field<uint8_t>(word, 36, 2);
    fields->op2 = field<uint8_t>(word, 35, 1);
    fields->partial = field<uint8_t>(word, 34, 1);
    fields->dest_bank = field<uint8_t>(word, 32, 2);
    fields->src1_bank = field<uint8_t>(word, 30, 2);
    fields->src2_bank = field<uint8_t>(word, 28, 2);
    fields->dest_num = field<uint8_t>(word, 21, 7);
    fields->src2_select = field<uint8_t>(word, 14, 7);
    fields->src1_num = field<uint8_t>(word, 7, 7);
    fields->src2_num = field<uint8_t>(word, 0, 7);
    if (!((*fields).op1 >= 2 && (*fields).op1 <= 6)) return false;
    return true;
}

bool encode_vbw(const VbwFields &fields, uint64_t *word) {
    if (!word ||
        !fits(static_cast<uint64_t>(fields.op1), 3) || !fits(static_cast<uint64_t>(fields.pred), 3) || !fits(static_cast<uint64_t>(fields.skip_invalid), 1) ||
        !fits(static_cast<uint64_t>(fields.no_schedule), 1) || !fits(static_cast<uint64_t>(fields.repeat_select), 1) || !fits(static_cast<uint64_t>(fields.sync_start), 1) ||
        !fits(static_cast<uint64_t>(fields.dest_ext), 1) || !fits(static_cast<uint64_t>(fields.end), 1) || !fits(static_cast<uint64_t>(fields.src1_ext), 1) ||
        !fits(static_cast<uint64_t>(fields.src2_ext), 1) || !fits(static_cast<uint64_t>(fields.repeat_count), 4) || !fits(static_cast<uint64_t>(fields.src2_invert), 1) ||
        !fits(static_cast<uint64_t>(fields.src2_rotate), 5) || !fits(static_cast<uint64_t>(fields.src2_extra_high), 2) || !fits(static_cast<uint64_t>(fields.op2), 1) ||
        !fits(static_cast<uint64_t>(fields.partial), 1) || !fits(static_cast<uint64_t>(fields.dest_bank), 2) || !fits(static_cast<uint64_t>(fields.src1_bank), 2) ||
        !fits(static_cast<uint64_t>(fields.src2_bank), 2) || !fits(static_cast<uint64_t>(fields.dest_num), 7) || !fits(static_cast<uint64_t>(fields.src2_select), 7) ||
        !fits(static_cast<uint64_t>(fields.src1_num), 7) || !fits(static_cast<uint64_t>(fields.src2_num), 7)) return false;
    if (!(fields.op1 >= 2 && fields.op1 <= 6)) return false;
    *word = kVbwExpected
        | bits(fields.op1, 59, 3)
        | bits(fields.pred, 56, 3)
        | bits(fields.skip_invalid, 55, 1)
        | bits(fields.no_schedule, 54, 1)
        | bits(fields.repeat_select, 53, 1)
        | bits(fields.sync_start, 52, 1)
        | bits(fields.dest_ext, 51, 1)
        | bits(fields.end, 50, 1)
        | bits(fields.src1_ext, 49, 1)
        | bits(fields.src2_ext, 48, 1)
        | bits(fields.repeat_count, 44, 4)
        | bits(fields.src2_invert, 43, 1)
        | bits(fields.src2_rotate, 38, 5)
        | bits(fields.src2_extra_high, 36, 2)
        | bits(fields.op2, 35, 1)
        | bits(fields.partial, 34, 1)
        | bits(fields.dest_bank, 32, 2)
        | bits(fields.src1_bank, 30, 2)
        | bits(fields.src2_bank, 28, 2)
        | bits(fields.dest_num, 21, 7)
        | bits(fields.src2_select, 14, 7)
        | bits(fields.src1_num, 7, 7)
        | bits(fields.src2_num, 0, 7);
    return true;
}

bool decode_kill(uint64_t word, KillFields *fields) {
    if (!fields || (word & kKillMask) != kKillExpected) return false;
    fields->dontcare_top = field<uint8_t>(word, 54, 2);
    fields->short_predicate = field<uint8_t>(word, 41, 2);
    fields->dontcare_payload = field<uint32_t>(word, 0, 28);
    return true;
}

bool encode_kill(const KillFields &fields, uint64_t *word) {
    if (!word ||
        !fits(static_cast<uint64_t>(fields.dontcare_top), 2) || !fits(static_cast<uint64_t>(fields.short_predicate), 2) || !fits(static_cast<uint64_t>(fields.dontcare_payload), 28)) return false;
    *word = kKillExpected
        | bits(fields.dontcare_top, 54, 2)
        | bits(fields.short_predicate, 41, 2)
        | bits(fields.dontcare_payload, 0, 28);
    return true;
}

